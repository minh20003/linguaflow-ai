# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/


# Environment variables — every variant is ignored, and the template is the one
# exception. Listing them one by one used to leave .env.development, .env.test
# and anything else a tool invents free to be committed with real keys in it.
.env*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
*.db
*.sqlite3

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content. The `**/` matters: a pattern
# containing a slash is anchored to this file's directory, so `.ai-log/*.jsonl`
# alone left `frontend/.ai-log/session.jsonl` — written whenever a tool ran with
# the frontend as its working directory — committable, prompts and all.
**/.ai-log/*.jsonl
**/.ai-log/archive/

# Team Docs (Office format, not renderable on GitHub)
docs/T217/

CLAUDE.md
