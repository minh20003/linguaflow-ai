# Public runtime configuration. The API URL and Google OAuth client ID are
# designed to be visible to browsers; do not put OAuth client secrets here.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Google Sign-In Client ID (Batch G)
# Lấy từ: https://console.cloud.google.com/apis/credentials?project=_
# Tạo OAuth Client ID (Web application) hoặc dùng Client ID đã có.
# Phải khớp với GOOGLE_OAUTH_CLIENT_ID bên backend (cùng một Web Client ID).
# Thêm Authorized JavaScript origins: http://localhost:3000, https://agent.dquangminh2003.id.vn
# Luồng GIS ID-token này không cần Google client secret hoặc OAuth redirect callback.
# Google đăng nhập tự động: đăng nhập theo google_sub, tự liên kết email Google đã xác minh
# chưa có google_sub, hoặc tạo tài khoản Google-native mới. Không đổi liên kết Google khác.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
