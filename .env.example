# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn provider: groq | deepseek | gemini | openai
# Chỉ cần điền API key của provider đang dùng.
LLM_PROVIDER=groq

# Để rỗng = dùng model mặc định của provider:
#   groq -> llama-3.3-70b-versatile | deepseek -> deepseek-chat
#   gemini -> gemini-2.5-flash      | openai   -> gpt-4o-mini
LLM_MODEL=
# Dich thuat khong phai viec sang tao — nhiet do thap giup model bam sat quy tac
# dinh dang trong TRANSLATE_SYSTEM_PROMPT thay vi dien dat lai theo y minh.
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=10
# Chan chi phi sinh van ban. Mot tin nhan chat khong bao gio can nhieu hon.
LLM_MAX_TOKENS=1024

# Groq — free, ~30 req/phút, inference nhanh nhất (mặc định)
GROQ_API_KEY=
# DeepSeek — OpenAI-compatible, giá rẻ
DEEPSEEK_API_KEY=
# Google Gemini — free, ~10 req/phút
GOOGLE_API_KEY=
# OpenAI — trả phí, ổn định nhất
OPENAI_API_KEY=

# ---- Database ----
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
# For SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT Authentication (Required) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Chỉ cần set biến môi trường, LangChain/LangGraph tự trace, không cần viết code.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Langfuse (Agent observability — F-03.4) ----
# Đo token, độ trễ và vết xử lý của Agent. Để trống thì tự động bỏ qua tracing.
# Đăng ký free tier tại https://cloud.langfuse.com hoặc tự host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Vung phai khop voi vung cap key: key US gui toi host EU se bi tra ve 401, va
# loi do xay ra o thread nen nen khong lam hong luong dich — tracing chi im lang
# khong ghi gi. Log luc khoi dong se bao ro dieu nay.
#   EU: https://cloud.langfuse.com    US: https://us.cloud.langfuse.com
# Chap nhan ca ten LANGFUSE_BASE_URL (ten ma SDK cua Langfuse dung).
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Agent ----
# Số tin nhắn gần nhất dùng làm ngữ cảnh dịch (PRD quy định 3-5)
AGENT_CONTEXT_SIZE=5

# ---- Provider dich du phong (ADR-07) ----
# Goi deep-translator khi LLM loi truoc khi tra ve nguyen ban. Khong can API key.
# Dat false de quay lai hanh vi cu: LLM loi thi tra thang ban goc.
FALLBACK_TRANSLATOR_ENABLED=true
FALLBACK_TRANSLATOR_TIMEOUT_SECONDS=5

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
