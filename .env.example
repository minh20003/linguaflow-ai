# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn provider: groq | deepseek | gemini | openai
# Chỉ cần điền API key của provider đang dùng.
LLM_PROVIDER=groq

# Để rỗng = dùng model mặc định của provider:
#   groq -> openai/gpt-oss-120b     | deepseek -> deepseek-chat
#   gemini -> gemini-2.5-flash      | openai   -> gpt-4o-mini
LLM_MODEL=
# Dich thuat khong phai viec sang tao — nhiet do thap giup model bam sat quy tac
# dinh dang trong TRANSLATE_SYSTEM_PROMPT thay vi dien dat lai theo y minh.
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=10
# Chan chi phi sinh van ban. Mot tin nhan chat khong bao gio can nhieu hon.
LLM_MAX_TOKENS=1024

# Ai chấm điểm trong eval, và bằng model nào (ADR-17). Để rỗng cả hai nghĩa là
# provider đang dịch tự chấm chính nó — chạy được, nhưng điểm bị thiên vị và
# báo cáo sẽ in cảnh báo. Đặt ở đây thay vì chỉ truyền cờ dòng lệnh vì judge là
# thứ điểm số được so với: hai lần chạy do hai model chấm không phải cùng một
# phép đo, và một cờ gõ khác nhau giữa hai ngày là cách dễ nhất để rơi vào đó.
LLM_JUDGE_PROVIDER=
# Rỗng = model mặc định của provider chấm điểm
JUDGE_MODEL=

# ---- Assistant Agent — model riêng, tách khỏi agent dịch (ADR-39) ----
# Không phải tiện lợi, mà vì hai agent bị chấm trên hai thứ khác nhau. Bản dịch
# được so với một câu tham chiếu và phải trả lời trong hạn NFR-01; trợ lý đọc
# hội thoại dài, lập kế hoạch nhiều bước, và bị chấm ở chỗ nó có bịa ra gì không.
# Model hợp với việc này thường không hợp với việc kia.
#
# Để rỗng nghĩa là kế thừa cấu hình của agent dịch, nên một deployment chưa cấu
# hình gì vẫn chạy y như hiện tại. Lưu ý: model CHỈ kế thừa khi provider cũng kế
# thừa — LLM_MODEL là tên model trên provider của agent dịch, mang sang provider
# khác thì lời gọi đầu tiên đã hỏng.
ASSISTANT_LLM_PROVIDER=
ASSISTANT_LLM_MODEL=
# Judge của trợ lý. Rỗng thì rơi về chính model sinh — chạy được, nhưng đó là tự
# chấm và log sẽ cảnh báo; điểm kiểu đó không so được với lần chạy khác.
ASSISTANT_JUDGE_PROVIDER=
ASSISTANT_JUDGE_MODEL=
# Model nhúng của trợ lý. Vector của nó nằm ở bảng `assistant_chunks`, không bao
# giờ dùng chung không gian với `message_embeddings` của agent dịch, nên đổi ở
# đây không làm hỏng đường dịch. Đổi model thì phải chạy lại backfill.
ASSISTANT_EMBEDDING_PROVIDER=
ASSISTANT_EMBEDDING_MODEL=
# Truy hồi hai tầng: top_k là số ứng viên hybrid search đưa cho reranker, top_n
# là số còn lại được đưa vào prompt. Nới cái đầu chỉ tốn một lần quét vector;
# nới cái sau tốn context và mời model chèn thêm những mẩu gần đúng.
ASSISTANT_RETRIEVAL_TOP_K=8
ASSISTANT_RERANK_TOP_N=4
# Bo cross-encoder xep hang lai. Dat false de bo qua han: ket qua ve lai thu tu
# hybrid da hop nhat, chinh la thu ma mot deployment khong cai goi nay van nhan
# duoc. Dat false neu may chu khong nap duoc torch.
#
# Day KHONG phai thu duy nhat dung model cuc bo: EMBEDDING_FALLBACK_PROVIDER=local
# o duoi cung can sentence-transformers. Ca hai dung chung mot lan import luc
# khoi dong, nen tat co nay khong lam mat tang du phong kia.
ASSISTANT_RERANK_ENABLED=true
# RAG của trợ lý LUÔN BẬT — cố ý không có cờ tắt. RAG_CONTEXT_ENABLED ở dưới là
# của agent dịch và vẫn tắt (ADR-27). Thứ duy nhất còn kiểm soát là consent
# `store_memory` của người dùng, tức là quyền chứ không phải cờ vận hành.

# Groq — free, ~30 req/phút, inference nhanh nhất (mặc định)
GROQ_API_KEY=
# DeepSeek — OpenAI-compatible, giá rẻ
DEEPSEEK_API_KEY=
# Google Gemini. `GEMINI_API_KEY` is accepted as a compatibility alias; when
# both names exist, the repository's established precedence uses this value.
GOOGLE_API_KEY=
# OpenAI — trả phí, ổn định nhất
OPENAI_API_KEY=

# ---- Speech-to-Text (voice messages only) ----
# Cau hinh doc lap voi LLM_PROVIDER. Gemini STT dung lai GOOGLE_API_KEY (hoac
# alias GEMINI_API_KEY) nhung khong thay doi provider/model dich. Adapter dung
# Files + Interactions API, model file non-live va mode verbatim.
STT_PROVIDER=gemini
STT_MODEL=gemini-3.5-transcribe
STT_TIMEOUT_SECONDS=60
STT_RETRY_ATTEMPTS=3

# ---- Glossary ngữ nghĩa ----
# Bật: tìm thuật ngữ trong câu kể cả khi người viết dùng biến thể ("môi trường
# thử nghiệm" cho "staging"). Truy hồi ngữ cảnh theo ngữ nghĩa thì TẮT — hai
# tính năng được đo riêng và kết quả khác nhau (ADR-26, ADR-27).
SEMANTIC_GLOSSARY_ENABLED=true
RAG_CONTEXT_ENABLED=false
# So doan hoi thoai truy hoi duoc dua vao prompt dich khi RAG_CONTEXT_ENABLED
# bat. Khong lien quan toi ASSISTANT_RETRIEVAL_TOP_K cua Assistant Agent.
# RAG_TOP_K=
# Để 0 = dùng bảng ngưỡng theo từng model trong src/services/embeddings.py.
# Ngưỡng là thuộc tính của không gian embedding chứ không phải của bài toán, nên
# một con số không phục vụ được nhiều model — và provider giờ tự đổi khi hết
# quota. Chỉ đặt khác 0 khi muốn đo một model mới mà không sửa mã.
# Model chưa đo được nhận ngưỡng gần như không khớp gì: hết quota thì suy giảm
# về khớp chuỗi, không phải về khớp bừa.
GLOSSARY_SIMILARITY_THRESHOLD=0
EMBEDDING_PROVIDER=gemini
# -001 va -2 deu da do nguong trong GLOSSARY_THRESHOLDS. Chon -001 o day vi day
# la model cua agent dich, noi glossary la thu dang bat mac dinh va -001 tach
# thuat ngu tot hon (8/8 bien the that so voi 6/8). Tro ly dung -2 o tren, vi no
# truy hoi doan van tot hon — hai viec khac nhau.
EMBEDDING_MODEL=models/gemini-embedding-001
# Tang du phong khi provider tren het quota: `local` chay trong tien trinh,
# khong can khoa va khong bi gioi han tan suat, nen mot han muc can khong lam
# dut dich vu. De rong = tat. Bat no di kem viec giu hai goi local trong
# requirements.txt (ADR-25).
EMBEDDING_FALLBACK_PROVIDER=local

# ---- Database ----
# PostgreSQL:
# Khop voi docker-compose.yml o thu muc goc: `docker compose up -d postgres`.
# Phai la PostgreSQL co pgvector, khong dung SQLite duoc nua (ADR-24).
DATABASE_URL=postgresql+asyncpg://linguaflow:linguaflow@localhost:5433/linguaflow
# PostgreSQL (trien khai): dan nguyen chuoi ket noi cua Railway/Supabase, ung
# dung tu doi `postgres://` va `postgresql://` sang `postgresql+asyncpg://`.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
# Kich thuoc pool — chi co tac dung voi PostgreSQL. Moi WebSocket giu mot phien
# suot thoi gian mo, nen day la so ket noi dong thoi chu khong phai req/s.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# Tai su dung ket noi truoc khi pooler phia nha cung cap dong no, va bao loi
# khi pool day thay vi de mot request cho vo han.
# DATABASE_POOL_RECYCLE_SECONDS=
# DATABASE_POOL_TIMEOUT_SECONDS=
# SQLAlchemy echo includes bound values such as message text and transcripts.
# Keep disabled unless diagnosing SQL locally with non-sensitive data.
DATABASE_ECHO=false
# Ket noi dau tien toi PostgreSQL quan ly co the lau hon mot request thuong luc
# cold start; noi rong de khong bao "database chua san sang" qua som.
# DATABASE_READINESS_TIMEOUT_SECONDS=

# ---- Tep dinh kem ----
# Thu muc luu tep. Tren container phai tro vao volume, neu khong tep se mat sau
# moi lan trien khai lai (xem docs/DEPLOY.md).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=20971520

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_ENV=production
# Ten ung dung hien trong log va tai lieu OpenAPI.
# APP_NAME=
# APP_PORT/APP_HOST khong con duoc doc o dau ca: container lay cong tu $PORT do
# nen tang tiem vao (xem CMD trong Dockerfile), con `make run` ghi cong san.
# Van khai bao trong src/config.py nen dat duoc khi can chay khac mac dinh:
# APP_PORT=
# APP_HOST=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
# Khop them theo bieu thuc chinh quy, cho ban xem truoc cua Vercel — moi pull
# request mot ten mien nen khong liet ke truoc duoc. De rong la tat.
# CORS_ORIGIN_REGEX=https://linguaflow-[a-z0-9-]+\.vercel\.app
# Mot origin cong khai duy nhat duoc them vao danh sach CORS ngoai CORS_ORIGINS.
# Tien khi trien khai: chi can dat ten mien that o day thay vi sua ca chuoi tren.
# PUBLIC_FRONTEND_ORIGIN=

# ---- JWT Authentication (Required) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Voi APP_ENV=production, gia tri mau duoi day bi tu choi va do dai toi thieu la
# 32 ky tu — ai giu chuoi nay deu ky duoc token cho bat ky tai khoan nao.
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Agent observability (F-03.4) ----
# Chon backend nhan trace: braintrust | langfuse | none. Mac dinh braintrust
# (ADR-29). Doi gia tri nay la cach duy nhat de doi backend — dung sua ma nguon.
# Ca hai backend deu suy giam im lang: thieu key, thieu goi hay init loi deu chi
# tat tracing chu khong lam hong mot ban dich nao.
OBSERVABILITY_PROVIDER=braintrust

# ---- Braintrust ----
# Key lay tai https://www.braintrust.dev/app/settings, bat dau bang `sk-`.
# De trong = tat tracing du OBSERVABILITY_PROVIDER dat gi.
BRAINTRUST_API_KEY=
# Project ma trace duoc xep vao. Braintrust tu tao project khi thay ten moi, nen
# go sai khong bao loi — no mo mot project rong thu hai.
BRAINTRUST_PROJECT=linguaflow

# ---- Langfuse (backend cu, van chon lai duoc) ----
# Đo token, độ trễ và vết xử lý của Agent. Để trống thì tự động bỏ qua tracing.
# Đăng ký free tier tại https://cloud.langfuse.com hoặc tự host.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Vung phai khop voi vung cap key: key US gui toi host EU se bi tra ve 401, va
# loi do xay ra o thread nen nen khong lam hong luong dich — tracing chi im lang
# khong ghi gi. Log luc khoi dong se bao ro dieu nay.
#   EU: https://cloud.langfuse.com    US: https://us.cloud.langfuse.com
# Chap nhan ca ten LANGFUSE_BASE_URL (ten ma SDK cua Langfuse dung).
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Agent ----
# Số tin nhắn gần nhất dùng làm ngữ cảnh dịch (PRD quy định 3-5)
AGENT_CONTEXT_SIZE=5
# Han cho tron mot luot dich, tinh ca nhan dien, LLM va provider du phong. Cac
# timeout rieng le khong chan duoc tong, nen day la thu dung tac vu nen (ADR-14).
TRANSLATION_TIMEOUT_SECONDS=30
# Chu ky quet hang doi nhac viec cua Assistant Agent (ADR-33). 60 giay la do
# phan giai mot loi nhac dang gia; quet day hon chi la mot truy van moi giay
# vao mot bang thuong rong.
# REMINDER_SCAN_INTERVAL_SECONDS=
# Dat false de tat bo lap nen ma khong go ma nguon. Test bat buoc phai tat:
# mot vong quet chay giua bo test se ban nhac viec cua test khac.
# REMINDER_SCHEDULER_ENABLED=

# ---- Provider dich du phong (ADR-07) ----
# Goi deep-translator khi LLM loi truoc khi tra ve nguyen ban. Khong can API key.
# Dat false de quay lai hanh vi cu: LLM loi thi tra thang ban goc.
FALLBACK_TRANSLATOR_ENABLED=true
FALLBACK_TRANSLATOR_TIMEOUT_SECONDS=5

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Transactional email: registration OTP and password-reset links ----
# Provider gửi email: smtp (gửi thật) | console (in ra terminal) | memory (dùng cho test)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Điền Gmail App Password (16 ký tự tạo từ myaccount.google.com/apppasswords) vào đây:
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=LinguaFlow
SMTP_USE_TLS=true
# Upper bound for one SMTP delivery attempt; prevents a stuck mail server from
# holding an API request forever.
SMTP_TIMEOUT_SECONDS=15

# ---- Google Sign-In (Batch G) ----
# OAuth 2.0 client ID từ Google Cloud Console → APIs & Services → Credentials.
# Dùng cùng Client ID với frontend (NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID).
# Authorized JavaScript origins: http://localhost:3000
# Luồng GIS ID-token này không cần Google client secret hoặc OAuth redirect callback.
# Google đăng nhập tự động: đăng nhập theo google_sub, tự liên kết email Google đã xác minh
# chưa có google_sub, hoặc tạo tài khoản Google-native mới. Không đổi liên kết Google khác.
GOOGLE_OAUTH_CLIENT_ID=

# Chỉ Google Calendar cần hai biến này, Sign-In thì không (ADR-35). Sign-In xác
# minh ID token tại chỗ và không bao giờ đổi code, nên không cần secret; Calendar
# chạy trọn luồng authorization-code và không hoạt động nếu thiếu.
# Redirect URI phải khớp **chính xác** mục trong Console, kể cả scheme và đường
# dẫn — lệch một ký tự thì Google trả `redirect_uri_mismatch` trước khi request
# tới được ứng dụng.
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Khoá Fernet mã hoá refresh token của Google Calendar khi lưu (ADR-35).
# **Thiếu khoá này thì tính năng tắt hẳn**, không bao giờ lưu token dạng rõ: một
# refresh token không phải dữ liệu của ứng dụng mà là quyền truy cập thường trực
# vào lịch thật của một người, còn hiệu lực tới khi họ tự thu hồi.
# Sinh khoá: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Chu ky dong bo hai chieu voi Google Calendar, tinh bang giay (ADR-35).
# CALENDAR_SYNC_INTERVAL_SECONDS=

# ---- AI Hook Logging (provided by instructor) ----
# Khoa do giang vien cap, dan vao .env cua may minh. Truoc day tep nay chua san
# mot khoa that (den tu commit khoi tao cua repo mau) — da go bo: .env.example
# duoc commit, nen moi gia tri o day deu la cong khai voi ca to chuc.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
# Duong dan tuong doi duoc tinh tu GOC REPO chu khong phai thu muc lam viec, nen
# cong cu chay tu frontend/ khong con tao ra mot thu muc log thu hai.
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Bien nay duoc doc luc BUILD frontend chu khong phai luc chay backend, nen no
# thuoc ve frontend/.env.local (xem frontend/.env.example). De o day cho du.
# NEXT_PUBLIC_API_URL=http://localhost:8000

